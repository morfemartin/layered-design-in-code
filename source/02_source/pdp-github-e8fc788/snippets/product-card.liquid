{% doc %}
  Renders a storefront product card with image, price and local wishlist control.
  @param {product} product - Product to render.
  @param {boolean} [show_wishlist] - Whether to show the wishlist button.
  @param {number} [delay] - Reveal stagger step (0, 1, 2…) when rendered inside a grid loop.
{% enddoc %}
{%- liquid
  assign reveal_delay = delay | default: 0 | times: 0.08 | at_most: 0.32
  assign color_option = null
  assign size_option_index = nil
  for option in product.options_with_values
    assign option_name_down = option.name | downcase
    if option_name_down contains 'color' or option_name_down contains 'colour'
      assign color_option = option
    elsif option_name_down == 'size' or option_name_down == 'talla'
      assign size_option_index = option.position | minus: 1
    endif
  endfor
  assign spec_key = ''
  assign product_handle_title = product.handle | append: ' ' | append: product.title | downcase
  if product_handle_title contains 'polo'
    assign spec_key = 'polo'
  elsif product_handle_title contains 'hoodie'
    assign spec_key = 'hoodie'
  elsif product_handle_title contains 'tee' or product_handle_title contains 't-shirt'
    assign spec_key = 'tee'
  endif
-%}
<article class="product-card" style="--reveal-delay:{{ reveal_delay }}s" data-reveal>
  <a class="product-card-media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if product.featured_media %}
      {{ product.featured_media.preview_image | image_url: width: 900 | image_tag: widths: '320, 480, 640, 900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: product.featured_media.alt | default: product.title | escape }}
    {% else %}
      <span class="product-placeholder"><img src="{{ 'arrive-logo-mark.svg' | asset_url }}" alt="" width="420" height="420"></span>
    {% endif %}
    {% render 'product-badges', product: product, context: 'card' %}
    {% if product.compare_at_price_max > product.price %}<span class="badge">{{ 'products.product.sale' | t }}</span>{% elsif product.tags contains 'new' %}<span class="badge">{{ 'products.product.new' | t }}</span>{% endif %}
  </a>
  {% if show_wishlist %}
    <button class="wishlist-button" type="button" data-wishlist="{{ product.id }}" data-wishlist-title="{{ product.title | escape }}" data-wishlist-url="{{ product.url }}" data-wishlist-price="{{ product.price | money | escape }}"{% if product.featured_media %} data-wishlist-image="{{ product.featured_media.preview_image | image_url: width: 240 }}"{% endif %} data-wishlist-message="{{ 'wishlist.updated' | t | escape }}" aria-label="{{ 'wishlist.toggle' | t: product: product.title | escape }}" aria-pressed="false">
      {% render 'icon', name: 'heart' %}
    </button>
  {% endif %}
  <div class="product-card-info">
    <div class="product-card-head">
      <h3 class="product-card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
      {% if color_option %}
        <div class="product-card-swatches" aria-hidden="true">
          {% for value in color_option.values limit: 5 %}
            <span class="product-card-swatch"{% if value.swatch.image %} style="--swatch-image:url('{{ value.swatch.image | image_url: width: 48 }}')"{% elsif value.swatch.color %} style="--swatch-color:rgb({{ value.swatch.color.rgb }})"{% endif %} title="{{ value | escape }}"></span>
          {% endfor %}
          {% if color_option.values.size > 5 %}<span class="product-card-swatch-more">+{{ color_option.values.size | minus: 5 }}</span>{% endif %}
        </div>
      {% endif %}
    </div>
    {% render 'product-spec', product: product, spec_key: spec_key, part: 'meta', size_option_index: size_option_index %}
    <div class="product-card-buy">
      <div class="product-card-price">{% render 'price', product: product %}</div>
    </div>
  </div>
</article>
